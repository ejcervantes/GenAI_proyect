# Database
# Docker Compose: use host "db". Local (no Docker): use "localhost".
DATABASE_URL=postgresql://passportai:passportai@db:5432/passportai

# Auth — change this in production!
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis
# Docker Compose: use host "redis". Local: use "localhost".
REDIS_URL=redis://redis:6379/0

# LLM (text generation for the Q&A agent / checklist / change summaries)
# LLM_PROVIDER: openai | ollama | mock
#   openai → uses OPENAI_API_KEY + OPENAI_BASE_URL below, model = OPENAI_CHAT_MODEL
#   ollama → local Ollama (OLLAMA_* below)
#   mock   → deterministic stub, no network
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
# Document scanner vision backend — kept mocked by default (independent of the
# chat model). Set false only when a real vision model is wired up.
VISION_MOCK=true
# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# Embeddings (external API for the RAG pipeline)
# Default provider is OpenAI. Leave OPENAI_API_KEY empty to run with a
# deterministic non-semantic fallback (dev only) — the app still works, but
# retrieval quality is poor. Set a real key for production-quality search.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ChromaDB (vector store)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=visa_policies

# Scraper
# true  = use the curated PK→DE seed corpus only (no network calls)
# false = fetch the official source pages live, with seed fallback per source
SCRAPER_MOCK=true

# Change tracking — daily re-scrape + diff-based re-ingestion
POLICY_REFRESH_INTERVAL_HOURS=24
